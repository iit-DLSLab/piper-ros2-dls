<?xml version="1.0"?>
<package format="3">
  <name>piper_sdk</name>
  <version>1.0.0</version>
  <description>pyAgxArm Python SDK packaged for ROS 2.</description>
  <maintainer email="antonio.langella@iit.it">Antonio Langella</maintainer>
  <license>LGPL-3.0-only</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>can-utils</exec_depend>
  <exec_depend>ethtool</exec_depend>
  <exec_depend>python3-can</exec_depend>
  <exec_depend>python3-typing-extensions</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
