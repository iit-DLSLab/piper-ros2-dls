<?xml version="1.0"?>
<package format="3">
  <name>agx_arm_compliance_bridge</name>
  <version>0.1.0</version>
  <description>Republishes JointState commands as agx_arm_msgs/MoveMITMsg, adding configurable per-joint MIT compliance gains.</description>
  <maintainer email="antonio.langella@iit.it">Antonio Langella</maintainer>
  <license>MIT</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>agx_arm_msgs</depend>
  <depend>generate_parameter_library_py</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
